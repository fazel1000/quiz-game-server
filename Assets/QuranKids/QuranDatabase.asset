  m_Script: {fileID: 11500000, guid: 507a846c2c0a08c4fba0801c5dfb6f22, type: 3}
  m_Name: QuranDatabase
  m_EditorClassIdentifier: 
  surahs:
  - number: 1
    nameArabic: "\u0627\u0644\u0641\u0627\u062A\u062D\u0647"
    namePersian: 
    verses:
    - number: 1
      arabicText: "\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650
        \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650"
      audio: {fileID: 0}
    - number: 2
      arabicText: "\u0627\u0644\u0652\u062D\u064E\u0645\u0652\u062F\u064F \u0644\u0644\u0651\u0647\u0650
        \u0631\u064E\u0628\u0651\u0650 \u0627\u0644\u0652\u0639\u064E\u0627\u0644\u064E\u0645\u0650\u064A\u0646\u064E"
      audio: {fileID: 0}
    - number: 3
      arabicText: "\u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650 "
      audio: {fileID: 0}
    - number: 4
      arabicText: "\u0645\u064E\u0627\u0644\u0650\u0643\u0650 \u064A\u064E\u0648\u0652\u0645\u0650
        \u0627\u0644\u062F\u0651\u0650\u064A\u0646\u0650\u0650"
      audio: {fileID: 0}
    - number: 5
      arabicText: "\u0625\u0650\u064A\u0651\u064E\u0627\u0643\u064E \u0646\u064E\u0639\u0652\u0628\u064F\u062F\u064F
        \u0648\u0625\u0650\u064A\u0651\u064E\u0627\u0643\u064E \u0646\u064E\u0633\u0652\u062A\u064E\u0639\u0650\u064A\u0646\u064F"
      audio: {fileID: 0}
    - number: 6
      arabicText: "\u0627\u0647\u062F\u0650\u0646\u064E\u0627 \u0627\u0644\u0635\u0651\u0650\u0631\u064E\u0627\u0637\u064E
        \u0627\u0644\u0645\u064F\u0633\u062A\u064E\u0642\u0650\u064A\u0645\u064E"
      audio: {fileID: 0}
    - number: 7
      arabicText: "\u0635\u0650\u0631\u064E\u0627\u0637\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E
        \u0623\u064E\u0646\u0639\u064E\u0645\u062A\u064E \u0639\u064E\u0644\u064E\u064A\u0647\u0650\u0645\u0652
        \u063A\u064E\u064A\u0631\u0650 \u0627\u0644\u0645\u064E\u063A\u0636\u064F\u0648\u0628\u0650
        \u0639\u064E\u0644\u064E\u064A\u0647\u0650\u0645\u0652 \u0648\u064E\u0644\u0627\u064E
        \u0627\u0644\u0636\u0651\u064E\u0627\u0644\u0651\u0650\u064A\u0646\u064E"
      audio: {fileID: 0}
