  originalText: "\n\n\u0645\u064E\u0627\u0644\u0650\u0643\u0650 \u064A\u064E\u0648\u0652\u0645\u0650
    \u0627\u0644\u062F\u0651\u0650\u064A\u0646\u0650 (\u0664)\n\n\u0625\u0650\u064A\u0651\u064E\u0627\u0643\u064E
