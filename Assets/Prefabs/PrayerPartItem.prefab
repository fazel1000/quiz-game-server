  originalText: "\u0648 \u0622\u0646\u0627\u0646 \u06A9\u0647 \u0628\u0647 \u0622\u0646\u0686\u0647
    \u0628\u0631 \u062A\u0648 \u0646\u0627\u0632\u0644 \u0634\u062F\u0647 \u0648
    \u0622\u0646\u0686\u0647 (\u0628\u0631 \u067E\u06CC\u0627\u0645\u0628\u0631\u0627\u0646)
    \u067E\u06CC\u0634 \u0627\u0632 \u062A\u0648 \u0646\u0627\u0632\u0644 \u0634\u062F\u0647\u060C
    \u0627\u06CC\u0645\u0627\u0646 \u0645\u06CC \u0622\u0648\u0631\u0646\u062F\u060C
    \u0648 \u0628\u0647 \u0631\u0648\u0632 \u0631\u0633\u062A\u0627\u062E\u06CC\u0632
    \u06CC\u0642\u06CC\u0646 \u062F\u0627\u0631\u0646\u062F.\u06A9\u0633\u0627\u0646\u06CC
    \u06A9\u0647 \u06A9\u0627\u0641\u0631 \u0634\u062F\u0646\u062F\u060C \u0628\u0631\u0627\u06CC
    \u0634\u0627\u0646 \u06CC\u06A9\u0633\u0627\u0646 \u0627\u0633\u062A \u06A9\u0647
    \u0622\u0646\u0627\u0646 \u0631\u0627 \u0628\u062A\u0631\u0633\u0627\u0646\u06CC
    \u06CC\u0627 \u0646\u062A\u0631\u0633\u0627\u0646\u06CC\u060C \u0627\u06CC\u0645\u0627\u0646
    \u0646\u0645\u06CC \u0622\u0648\u0631\u0646\u062F."
